DATABASE_URL=postgres://reliability:reliability@localhost:55432/reliability
TEST_DATABASE_URL=postgres://reliability:reliability@localhost:55432/reliability_test
# Serverless deployments connect through a transaction pooler. Set DATABASE_POOLED=true
# when DATABASE_URL is a pooled endpoint that does not advertise pgbouncer=true, and
# DIRECT_DATABASE_URL to the unpooled endpoint so migrations and drizzle-kit avoid it.
DATABASE_POOLED=
DIRECT_DATABASE_URL=
DEMO_MODE=true
# Set DEMO_MODE=false and fill every GitHub field to enable integration.
# On Vercel, APP_URL may be left empty: the deployment derives its own HTTPS origin
# from the branch (preview) or production hostname. Set it to use a custom domain.
APP_URL=http://localhost:3000
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional workspace invitation delivery; configure both to enable invitations.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# RESEND_FROM_EMAIL must use a sender domain verified in Resend.
# Production: HTTPS APP_URL, INNGEST_DEV=0, and configured Inngest keys.
# Invitations remain unavailable until both Resend settings are present.
